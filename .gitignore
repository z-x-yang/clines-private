# figures/ - LaTeX figure build binaries (from origin/i2b2)
figures/

# papers/ contains the canonical LaTeX source for the BMJ revision plus
# revision-side response artifacts. The Submission/ subtree (LaTeX manuscript
# + supplement source, figures, vendor class files, accompanying source-code
# snapshot) is fully tracked starting 2026-05-28; the Major Revision/ subtree
# uses a deny-by-default + selective whitelist below to keep PHI-bearing
# cross-annotation binaries out.
papers/*
!papers/BMJ_AI_Submission/
# Re-include the LaTeX figures/ dir that the global `figures/` rule (line 42)
# would otherwise block.
!papers/BMJ_AI_Submission/Submission/CLINES latex bmj/figures/
!papers/BMJ_AI_Submission/Major Revision/
papers/BMJ_AI_Submission/Major Revision/*
!papers/BMJ_AI_Submission/Major Revision/*.md
!papers/BMJ_AI_Submission/Major Revision/*.txt
!papers/BMJ_AI_Submission/Major Revision/*.pdf
!papers/BMJ_AI_Submission/Major Revision/cross-annotation/
papers/BMJ_AI_Submission/Major Revision/cross-annotation/*
!papers/BMJ_AI_Submission/Major Revision/cross-annotation/*.txt
# Revision response artifacts (LaTeX letters, figure scripts/data, figure PDFs).
!papers/BMJ_AI_Submission/Major Revision/response/
papers/BMJ_AI_Submission/Major Revision/response/*
!papers/BMJ_AI_Submission/Major Revision/response/*.tex
!papers/BMJ_AI_Submission/Major Revision/response/*.md
!papers/BMJ_AI_Submission/Major Revision/figure_scripts/
papers/BMJ_AI_Submission/Major Revision/figure_scripts/*
!papers/BMJ_AI_Submission/Major Revision/figure_scripts/*.py
!papers/BMJ_AI_Submission/Major Revision/figure_scripts/*.md
!papers/BMJ_AI_Submission/Major Revision/figure_scripts/data/
papers/BMJ_AI_Submission/Major Revision/figure_scripts/data/*
!papers/BMJ_AI_Submission/Major Revision/figure_scripts/data/*.csv
!papers/BMJ_AI_Submission/Major Revision/figure_scripts/data/*.json
!papers/BMJ_AI_Submission/Major Revision/figures/
papers/BMJ_AI_Submission/Major Revision/figures/*
!papers/BMJ_AI_Submission/Major Revision/figures/*.pdf
!papers/BMJ_AI_Submission/Major Revision/figures/*.png
